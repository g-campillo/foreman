<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- V8 compiles and executes at runtime. Without these two, the renderer
       crashes on launch under hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- Electron sets DYLD_* when launching its helpers. -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>

  <!-- Not optional for this app specifically: it loads the node-pty and
       electron-liquid-glass native addons out of app.asar.unpacked, and spawns
       the SDK's separate `claude` executable from there too. Library validation
       rejects both, because they are not signed by this app's team. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
